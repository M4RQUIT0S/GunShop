# Restos de trabajo: capturas, diffs y scratch de las revisiones.
*.diff
difftmp.txt
shots/
tmp/
node_modules/
.DS_Store
Thumbs.db
__pycache__/
*.pyc

# Next.js
.next/
next-env.d.ts
.vercel/

# Entorno: la URL y la clave publicable van en .env.example con marcador de
# posicion; el fichero real no entra nunca, y la service_role menos.
.env
.env*.local

# Obsidian: si un vault acaba solapando el repo, su configuracion cambia cada
# vez que se mueve un panel y no pinta nada en el historial. El contenido (los
# .md) si se puede commitear, si alguna vez se quiere.
.obsidian/

# Config de agentes: apunta a proyectos reales y es de cada maquina.
.codex/*
!.codex/config.example.toml
.claude/settings.local.json
