# Copiar a .env.local y rellenar. El fichero real esta ignorado.

# Las dos publicas: van al navegador a proposito. Lo que protege los datos es
# la RLS de 0006_rls.sql, no esconder la clave.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXX

# Solo en servidor, y nunca con prefijo NEXT_PUBLIC_: esta clave se salta la
# RLS entera. Si aparece en el navegador, la base esta abierta.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional. Solo si el dominio publico no es el que Vercel expone en
# VERCEL_PROJECT_PRODUCTION_URL (por ejemplo, un dominio propio).
NEXT_PUBLIC_SITIO=

# El acceso con Google NO anade variable: se configura en el panel de Supabase
# (Authentication -> Providers -> Google, con el Client ID/Secret de Google
# Cloud) y en Authentication -> URL Configuration, donde hacen falta
# `http://localhost:3000/**` y `https://<dominio>/**` en Redirect URLs -- el
# `/**` porque se vuelve a la pagina en la que estabas, no a una fija.
# Ver CLAUDE.md, "Cuenta: Google, y ninguna credencial".
